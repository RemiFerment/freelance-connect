{% extends 'base.html.twig' %}

{% block title %}Candidature de
	{{candidacy.freelance.firstname}}
	{{candidacy.freelance.lastname}}
{% endblock %}

{% block body %}
	<div class="container mt-5">
		<div class="d-flex align-items-center gap-3 mb-5">
			<button type="button" class="btn btn-outline-secondary" onclick="history.back()">
				<i class="bi bi-chevron-left"></i>
			</button>
			<h1 class="fs-4">Candidature de
				{{candidacy.freelance.firstname}}
				{{candidacy.freelance.lastname}}
				-
				{{candidacy.mission.title}}</h1>
		</div>

		<div class="row">
			<div class="col-lg-8">
				<div class="card mb-4">
					<div class="card-header bg-dark-subtle text-white">
						<h5 class="card-title mb-0">Informations du candidat</h5>
					</div>
					<div class="card-body">
						<div class="row mb-3">
							<div class="col-md-6">
								<p>
									<strong>Nom:</strong>
									{{candidacy.freelance.lastname}}</p>
							</div>
							<div class="col-md-6">
								<p>
									<strong>Prénom:</strong>
									{{candidacy.freelance.firstname}}</p>
							</div>
						</div>
						<hr>
						<div class="row mb-3">
							<div class="col-md-6">
								<p>
									<strong>Mission:</strong>
									{{candidacy.mission.title}}</p>
							</div>
							<div class="col-md-6">
								<p>
									<strong>Date de candidature:</strong>
									{{candidacy.createdAt|date('d/m/Y')}}</p>
							</div>
						</div>
					</div>
				</div>

				<div class="card mb-4">
					<div class="card-header bg-dark-subtle text-white">
						<h5 class="card-title mb-0">Détails de la candidature</h5>
					</div>
					<div class="card-body">
						<div class="mb-3">
							<label class="form-label">
								<strong>Motivation:</strong>
							</label>
							<p class="text-muted">{{candidacy.motivation}}</p>
						</div>
						<div class="mb-3">
							<label class="form-label">
								<strong>Liens du projet:</strong>
							</label>
							<p>
								{{candidacy.projectLinks}}
							</p>
						</div>
						<div class="mb-3">
							<label class="form-label">
								<strong>CV:</strong>
							</label>
							<p>
								{% if candidacy.cvFilePath %}
									<a href="{{candidacy.cvFilePath}}" target="_blank" class="btn btn-sm btn-outline-secondary">Télécharger le CV</a>
								{% else %}
									<span class="text-muted">Aucun CV fourni</span>
								{% endif %}
							</p>
						</div>
					</div>
				</div>
			</div>

			<div class="col-lg-4">
				<div class="card">
					<div class="card-header bg-dark-subtle text-white">
						<h5 class="card-title mb-0">Statut</h5>
					</div>
					<div class="card-body text-center">
						<span class="badge bg-success fs-6">{{candidacy.status.label}}</span>
						<div class="mt-4 d-flex gap-2">
							<a type="button" class="btn btn-success flex-fill">
								<i class="bi bi-check-circle"></i>
								Accepter
							</a>
							<a type="button" class="btn btn-danger flex-fill">
								<i class="bi bi-x-circle"></i>
								Refuser
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>

	{% endblock %}
