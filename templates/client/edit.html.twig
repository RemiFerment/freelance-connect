{% extends 'base.html.twig' %}

{% block title %}Modifier la mission

{% endblock %}

{% block body %}
	<div class="container-fluid py-4">
		<div class="d-flex align-items-center gap-2 mb-4">
			<a class="btn btn-outline-secondary fs-3" href="{{ path('app_client_index') }}">
				<i class="bi bi-chevron-left"></i>
			</a>
			<h1 class="mb-0">Modification de la mission : {{ mission.title }}</h1>
		</div>

		<div class="card bg-dark border-secondary">
			<div class="card-body">
				{{ include('client/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
			</div>
		</div>

		{% if is_granted('ROLE_ADMIN') %}
			<div class="card bg-dark border-danger mt-3">
				<div class="card-body">
					{{ include('client/_delete_form.html.twig') }}
				</div>
			</div>
		{% endif %}

		<div class="mt-3">
			{{ include('client/_cancel_form.html.twig') }}
		</div>
	</div>
{% endblock %}
