{% extends 'base.html.twig' %}

{% block title %}Dashboard Candidatures
{% endblock %}

{% block body %}
	<div class="container mt-5">
		<div class="d-flex align-items-center gap-3 mb-5">
			<button type="button" class="btn btn-outline-secondary" onclick="history.back()">
				<i class="bi bi-chevron-left"></i>
			</button>
			<h1 class="mb-0">Les Candidatures par mission</h1>
		</div>

		{% for mission in missions %}
			<div class="card mb-4 shadow-sm">
				<div class="card-header bg-dark-subtle text-white">
					<h2 class="fs-5 mb-0">{{ mission.title }}</h2>
				</div>
				<div class="card-body">
					{% if not mission.candidacies %}
						<div class="alert alert-info" role="alert">
							<i class="bi bi-info-circle"></i>
							Aucune candidature pour cette mission.
						</div>
					{% else %}
						<div class="list-group">
							{% for candidacy in mission.candidacies %}
								<div class="list-group-item">
									<div class="d-flex w-100 justify-content-between align-items-center">
										<div>
											<h6 class="mb-1">
												<i class="bi bi-person-circle"></i>
												{{ candidacy.freelance.firstname }}
												{{ candidacy.freelance.lastname }}
											</h6>
											<p class="mb-0 text-muted small">Candidature soumise</p>
										</div>
										<a class="btn btn-sm btn-success" href="{{path('app_candidacy',{id:candidacy.id})}}">


											<i class="bi bi-eye"></i>
											Voir la candidature
										</a>
									</div>
								</div>
							{% endfor %}
						</div>
					{% endif %}
				</div>
			</div>
		{% endfor %}
	</div>

{% endblock %}
