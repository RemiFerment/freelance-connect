<form method="post" action="{{ path('app_client_delete', {'id': mission.id}) }}" onsubmit="return confirm('Êtes-vous sûr de supprimer cette mission ? (Irreversible)');">
	<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ mission.id) }}">
<button class="btn btn-danger btn-lg active">Supprimer la mission</button>

</form>
