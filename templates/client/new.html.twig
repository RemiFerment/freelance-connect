{% extends 'base.html.twig' %}

{% block title %}Nouvelle Mission{% endblock %}

{% block body %}
    <div class="container mt-5 mb-5">
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <div class="card bg-dark border-secondary shadow-lg">
                    <div class="card-body p-5">
                        <h1 class="card-title mb-4 text-white">
                            <i class="bi bi-plus-circle me-2"></i>Créer une nouvelle Mission
                        </h1>

                        {{ include('client/_form.html.twig', {'button_label': 'Créer la mission'}) }}

                        <a href="{{ path('app_client_index') }}" class="btn btn-outline-secondary mt-4">
                            <i class="bi bi-arrow-left"></i> Retour à la liste
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
