{% extends 'base.html.twig' %}

{% block title %}Mission
{% endblock %}

{% block body %}
	<h1>Mission</h1>

	<table class="table">
		<tbody>
			<tr>
				<th>Id</th>
				<td>{{ mission.id }}</td>
			</tr>
			<tr>
				<th>Titre</th>
				<td>{{ mission.title }}</td>
			</tr>
			<tr>
				<th>Description</th>
				<td>{{ mission.description }}</td>
			</tr>
			<tr>
				<th>Budget</th>
				<td>{{ mission.budget }}</td>
			</tr>
			<tr>
				<th>Délai</th>
				<td>{{ mission.deadline ? mission.deadline|date('Y-m-d') : '' }}</td>
			</tr>
			<tr>
				<th>Créé le</th>
				<td>{{ mission.createdAt ? mission.createdAt|date('Y-m-d H:i:s') : '' }}</td>
			</tr>
			<tr>
				<th>Mis à jour le</th>
				<td>{{ mission.updatedAt ? mission.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
			</tr>
		</tbody>
	</table>

	<div class="d-flex gap-2">
		<a class="btn btn-secondary" href="{{ path('app_client_index') }}">Retour</a>

		<a class="btn btn-primary" href="{{ path('app_client_edit', {'id': mission.id}) }}">
			<i class="bi bi-pencil-fill"></i>
			Modifier</a>

		{% if is_granted('ROLE_ADMIN') %}
			{{ include('client/_delete_form.html.twig') }}
		{% endif %}

		{{ include('client/_cancel_form.html.twig') }}
	</div>

{% endblock %}
