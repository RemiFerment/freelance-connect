{% extends 'base.html.twig' %}

{% block title %}Dashboard Mission
{% endblock %}

{% block body %}
	<h1>Mes Missions</h1>

	<table class="table">
		<thead>
			<tr>
				<th>Id</th>
				<th>Title</th>
				<th>Description</th>
				<th>Budget</th>
				<th>Deadline</th>
				<th>CreatedAt</th>
				<th>UpdatedAt</th>
				<th>actions</th>
			</tr>
		</thead>
		<tbody>
			{% for mission in missions %}
				<tr>
					<td>{{ mission.id }}</td>
					<td>{{ mission.title }}</td>
					<td>{{ mission.description }}</td>
					<td>{{ mission.budget }}</td>
					<td>{{ mission.deadline ? mission.deadline|date('Y-m-d') : '' }}</td>
					<td>{{ mission.createdAt ? mission.createdAt|date('Y-m-d H:i:s') : '' }}</td>
					<td>{{ mission.updatedAt ? mission.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
					<td>
						<a href="{{ path('app_client_show', {'id': mission.id}) }}">Regarder</a>
						<a href="{{ path('app_client_edit', {'id': mission.id}) }}">Modifier</a>
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="8">Aucune mission à afficher.</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>

	<a class="btn btn-success" href="{{ path('app_client_new') }}">Créer une nouvelle mission</a>
{% endblock %}
