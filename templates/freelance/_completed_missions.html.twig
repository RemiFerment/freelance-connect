{% if completedMissions is empty %}

    <div class="alert alert-info">
        Aucune mission terminée.
    </div>
    
{% else %}

    <div class="row g-4">
        {% for mission in completedMissions %}
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">
                            {{ mission.title }}
                        </h5>
                        <p>
                            {{ mission.description }}
                        </p>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

{% endif %}