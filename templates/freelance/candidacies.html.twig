{% extends 'base.html.twig' %}

{% block title %}
    Mes candidatures
{% endblock %}

{% block body %}

<div class="container">
    <h1 class="mb-4">Mes candidatures</h1>

    {% if candidacies is empty %}
        <div class="alert alert-info">
            Vous n'avez encore envoyé aucune candidature.
        </div>
    {% else %}

        <div class="row g-4">
            {% for candidacy in candidacies %}
                <div class="col-md-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h5 class="card-title">
                                {{ candidacy.mission.title }}
                            </h5>
                            <p class="card-text">
                                <strong>Client :</strong>
                                {{ candidacy.client.firstname }}
                                {{ candidacy.client.lastname }}
                            </p>
                            <p class="card-text">
                                <strong>Date de candidature :</strong>
                                {{ candidacy.createdAt|date('d/m/Y') }}
                            </p>
                            <p>
                                <strong>Statut :</strong>
                                {% if candidacy.status.code == 'PENDING' %}
                                    <span class="badge bg-warning text-dark">
                                        En attente
                                    </span>
                                {% elseif candidacy.status.code == 'ACCEPTED' %}
                                    <span class="badge bg-success">
                                        Acceptée
                                    </span>
                                {% elseif candidacy.status.code == 'REJECTED' %}
                                    <span class="badge bg-danger">
                                        Refusée
                                    </span>
                                {% endif %}
                            </p>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>

{% endblock %}