{% extends 'base.html.twig' %}

{% block title %}
    Candidater - {{ mission.title }}
{% endblock %}

{% block body %}

<div class="d-flex justify-content-center align-items-center min-vh-100 p-3">
    <div class="w-100" style="max-width: 600px;">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">

                <h1 class="text-center mb-3">
                    Candidater
                </h1>

                <h5 class="text-center text-muted mb-4">
                    {{ mission.title }}
                </h5>

                {{ form_errors(form, { 'attr': { 'class': 'alert alert-danger' }}) }}


                {{ form_start(form, { 'attr': { 'class': 'needs-validation','novalidate': 'novalidate'} }) }}


                {{ form_row(form.motivation, {'attr': {'class': 'form-control'}}) }}


                {{ form_row(form.cvFilePath, {'attr': {'class': 'form-control'}}) }}


                {{ form_row(form.projectLinks, {'attr': {'class': 'form-control'}}) }}


                <button type="submit" class="btn btn-primary w-100 mt-4">
                    Envoyer ma candidature
                </button>


                {{ form_end(form) }}

            </div>
        </div>
    </div>
</div>

{% endblock %}