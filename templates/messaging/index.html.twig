{% extends 'base.html.twig' %}

{% block title %}Messagerie{% endblock %}

{% block body %}
<div class="container-fluid h-100" style="background-color: #1a1a1a; color: #e0e0e0;">
    <div class="row h-100 g-0">
        <!-- Conversations List -->
        <div class="col-md-4 border-end border-dark" style="background-color: #0d0d0d; max-height: 100vh; overflow-y: auto;">
            <div class="p-3 border-bottom border-dark">
                <h5 class="mb-0">Messages</h5>
            </div>

            {% for message in app.flashes('error') %}
                <div class="alert alert-danger m-2 py-2 small">{{ message }}</div>
            {% endfor %}

            <div class="list-group list-group-flush">
                {% if conversations is empty %}
                    <div class="p-4 text-muted text-center">
                        <i class="bi bi-chat-dots fs-2"></i>
                        <p class="mt-2 small">Aucune conversation.<br>Une mission en cours est nécessaire pour démarrer une discussion.</p>
                    </div>
                {% else %}
                    {% for conversation in conversations %}
                        {% set otherUserId = null %}
                        {% for participantId in conversation.participantIds %}
                            {% if participantId != currentUserId %}{% set otherUserId = participantId %}{% endif %}
                        {% endfor %}
                        {% set otherUser = participantsMap[otherUserId] ?? null %}
                        {% set unread = conversation.unreadCount[currentUserId]|default(0) %}
                        {% set isActive = activeConversation is not null and activeConversation.id == conversation.id %}

                        <a href="{{ path('app_messaging_show', {id: conversation.id}) }}"
                           class="list-group-item list-group-item-action"
                           style="background-color: {{ isActive ? '#2a2a2a' : '#0d0d0d' }}; border-color: #333; color: #e0e0e0;">
                            <div class="d-flex align-items-center">
                                <div class="me-2 flex-shrink-0 d-flex align-items-center justify-content-center fw-bold text-light"
                                     style="width: 42px; height: 42px; background-color: #404040; border-radius: 50%; font-size: 0.75rem;">
                                    {% if otherUser %}{{ otherUser.firstname|first|upper }}{{ otherUser.lastname|first|upper }}{% else %}?{% endif %}
                                </div>
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <strong class="text-light text-truncate">
                                            {% if otherUser %}{{ otherUser.firstname }} {{ otherUser.lastname }}{% else %}Utilisateur inconnu{% endif %}
                                        </strong>
                                        <small class="text-muted ms-2 flex-shrink-0">{{ conversation.updatedAt|date('d/m H:i') }}</small>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <small class="text-muted text-truncate">{{ conversation.lastMessageText|default('Nouvelle conversation') }}</small>
                                        {% if unread > 0 %}
                                            <span class="badge bg-primary ms-1">{{ unread }}</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </a>
                    {% endfor %}
                {% endif %}
            </div>
        </div>

        <!-- Chat Area -->
        <div class="col-md-8 d-flex flex-column" style="background-color: #1a1a1a; max-height: 100vh;">
            {% if activeConversation is not null %}
                {% set otherUserId = null %}
                {% for participantId in activeConversation.participantIds %}
                    {% if participantId != currentUserId %}{% set otherUserId = participantId %}{% endif %}
                {% endfor %}
                {% set otherUser = participantsMap[otherUserId] ?? null %}

                <!-- Header -->
                <div class="p-3 border-bottom border-dark flex-shrink-0" style="background-color: #0d0d0d;">
                    <div class="d-flex align-items-center">
                        <div class="me-2 flex-shrink-0 d-flex align-items-center justify-content-center fw-bold text-light"
                             style="width: 42px; height: 42px; background-color: #404040; border-radius: 50%; font-size: 0.75rem;">
                            {% if otherUser %}{{ otherUser.firstname|first|upper }}{{ otherUser.lastname|first|upper }}{% else %}?{% endif %}
                        </div>
                        <div>
                            <h6 class="mb-0 text-light">
                                {% if otherUser %}{{ otherUser.firstname }} {{ otherUser.lastname }}{% else %}Utilisateur inconnu{% endif %}
                            </h6>
                        </div>
                    </div>
                </div>

                <!-- Messages -->
                <div class="flex-grow-1 overflow-y-auto p-4" id="messages-container" style="background-color: #1a1a1a;">
                    {% for message in messages %}
                        {% set isOwn = message.senderId == currentUserId %}
                        {% set sender = participantsMap[message.senderId] ?? null %}

                        <div class="mb-3 d-flex {{ isOwn ? 'justify-content-end' : '' }}">
                            {% if not isOwn %}
                                <div class="me-2 flex-shrink-0 d-flex align-items-center justify-content-center"
                                     style="width: 30px; height: 30px; background-color: #404040; border-radius: 50%; font-size: 0.7rem; color: #aaa; align-self: flex-end;">
                                    {% if sender %}{{ sender.firstname|first|upper }}{% else %}?{% endif %}
                                </div>
                            {% endif %}
                            <div style="background-color: {{ isOwn ? '#0056b3' : '#2a2a2a' }}; border-radius: 10px; padding: 10px 15px; max-width: 70%;">
                                <p class="mb-1 text-light" style="white-space: pre-wrap; word-break: break-word;">{{ message.content }}</p>
                                <small class="{{ isOwn ? 'text-light opacity-75' : 'text-muted' }}">{{ message.createdAt|date('H:i') }}</small>
                            </div>
                        </div>
                    {% else %}
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-chat" style="font-size: 2rem;"></i>
                            <p class="mt-2 small">Aucun message. Commencez la conversation !</p>
                        </div>
                    {% endfor %}
                </div>

                <!-- Input Area -->
                <div class="p-3 border-top border-dark flex-shrink-0" style="background-color: #0d0d0d;">
                    <form action="{{ path('app_messaging_send', {id: activeConversation.id}) }}" method="post" class="d-flex gap-2">
                        <input type="hidden" name="_token" value="{{ csrf_token('send_message_' ~ activeConversation.id) }}">
                        <input type="text" name="content" class="form-control form-control-dark flex-grow-1"
                               placeholder="Écrivez votre message..." autocomplete="off"
                               style="background-color: #2a2a2a; border-color: #444; color: #e0e0e0;">
                        <button type="submit" class="btn btn-primary">Envoyer</button>
                    </form>
                </div>
            {% else %}
                <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                    <div class="text-center">
                        <i class="bi bi-chat-dots" style="font-size: 3rem; opacity: 0.4;"></i>
                        <p class="mt-3">Sélectionnez une conversation</p>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<style>
    .form-control-dark {
        background-color: #2a2a2a !important;
        border-color: #444 !important;
        color: #e0e0e0 !important;
    }
    .form-control-dark::placeholder {
        color: #999 !important;
    }
    .form-control-dark:focus {
        background-color: #2a2a2a !important;
        border-color: #666 !important;
        color: #e0e0e0 !important;
        box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25) !important;
    }
    body {
        height: 100vh;
        overflow: hidden;
    }
</style>

<script>
    const container = document.getElementById('messages-container');
    if (container) {
        container.scrollTop = container.scrollHeight;
    }
</script>
{% endblock %}

