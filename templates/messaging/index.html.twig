{% extends 'base.html.twig' %}

{% block title %}Messagerie{% endblock %}

{% block body %}
    <div class="messaging-container">
        <div class="messaging-header">
            <h1>Messagerie</h1>
        </div>
        
        <div class="messaging-main">
            <!-- Conversations list -->
            <div class="conversations-panel">
                <div class="conversations-header">
                    <h2>Conversations</h2>
                </div>
                <div class="conversations-list">
                    <div class="conversation-item active">
                        <div class="conversation-avatar">👤</div>
                        <div class="conversation-info">
                            <h3>John Doe</h3>
                            <p>Last message preview...</p>
                        </div>
                        <span class="conversation-time">10:30</span>
                    </div>
                    <div class="conversation-item">
                        <div class="conversation-avatar">👤</div>
                        <div class="conversation-info">
                            <h3>Jane Smith</h3>
                            <p>Previous message...</p>
                        </div>
                        <span class="conversation-time">Yesterday</span>
                    </div>
                </div>
            </div>
            
            <!-- Messages display -->
            <div class="messages-panel">
                <div class="messages-header">
                    <h2>John Doe</h2>
                    <button class="info-btn">ℹ️</button>
                </div>
                
                <div class="messages-list">
                    <div class="message received">
                        <p>Hello! How are you?</p>
                        <span class="message-time">10:15</span>
                    </div>
                    <div class="message sent">
                        <p>Hi! I'm doing great, thanks!</p>
                        <span class="message-time">10:20</span>
                    </div>
                    <div class="message received">
                        <p>That's wonderful to hear</p>
                        <span class="message-time">10:25</span>
                    </div>
                </div>
                
                <div class="messages-input">
                    <input type="text" placeholder="Type your message...">
                    <button class="send-btn">Send</button>
                </div>
            </div>
        </div>
    </div>
    
    <style>
        .messaging-container {
            display: flex;
            flex-direction: column;
            height: 100vh;
            background-color: #f5f5f5;
        }
        
        .messaging-header {
            padding: 20px;
            background-color: #fff;
            border-bottom: 1px solid #ddd;
        }
        
        .messaging-header h1 {
            margin: 0;
            font-size: 24px;
            color: #333;
        }
        
        .messaging-main {
            display: flex;
            flex: 1;
            overflow: hidden;
        }
        
        .conversations-panel {
            width: 30%;
            background-color: #fff;
            border-right: 1px solid #ddd;
            display: flex;
            flex-direction: column;
        }
        
        .conversations-header {
            padding: 15px 20px;
            border-bottom: 1px solid #ddd;
        }
        
        .conversations-header h2 {
            margin: 0;
            font-size: 18px;
            color: #333;
        }
        
        .conversations-list {
            flex: 1;
            overflow-y: auto;
        }
        
        .conversation-item {
            display: flex;
            padding: 15px;
            border-bottom: 1px solid #f0f0f0;
            cursor: pointer;
            transition: background-color 0.2s;
        }
        
        .conversation-item:hover {
            background-color: #f9f9f9;
        }
        
        .conversation-item.active {
            background-color: #e8f4f8;
        }
        
        .conversation-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background-color: #e0e0e0;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 10px;
            font-size: 24px;
        }
        
        .conversation-info {
            flex: 1;
        }
        
        .conversation-info h3 {
            margin: 0 0 5px 0;
            font-size: 14px;
            color: #333;
        }
        
        .conversation-info p {
            margin: 0;
            font-size: 12px;
            color: #999;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        
        .conversation-time {
            font-size: 12px;
            color: #999;
        }
        
        .messages-panel {
            flex: 1;
            background-color: #fff;
            display: flex;
            flex-direction: column;
        }
        
        .messages-header {
            padding: 15px 20px;
            border-bottom: 1px solid #ddd;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .messages-header h2 {
            margin: 0;
            font-size: 18px;
            color: #333;
        }
        
        .info-btn {
            background: none;
            border: none;
            font-size: 20px;
            cursor: pointer;
        }
        
        .messages-list {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        
        .message {
            display: flex;
            flex-direction: column;
            margin-bottom: 10px;
        }
        
        .message.received {
            align-items: flex-start;
        }
        
        .message.sent {
            align-items: flex-end;
        }
        
        .message p {
            max-width: 60%;
            padding: 10px 15px;
            border-radius: 8px;
            margin: 0 0 5px 0;
            font-size: 14px;
            word-wrap: break-word;
        }
        
        .message.received p {
            background-color: #e8e8e8;
            color: #333;
        }
        
        .message.sent p {
            background-color: #007bff;
            color: white;
        }
        
        .message-time {
            font-size: 12px;
            color: #999;
        }
        
        .messages-input {
            padding: 15px 20px;
            border-top: 1px solid #ddd;
            display: flex;
            gap: 10px;
        }
        
        .messages-input input {
            flex: 1;
            padding: 10px 15px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 14px;
        }
        
        .send-btn {
            padding: 10px 20px;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            transition: background-color 0.2s;
        }
        
        .send-btn:hover {
            background-color: #0056b3;
        }
    </style>
{% endblock %}
