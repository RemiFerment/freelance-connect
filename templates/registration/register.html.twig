{% extends 'base.html.twig' %}

{% block title %}Register
{% endblock %}

{% block body %}

	<div class="min-vh-100 d-flex align-items-center py-5 px-3 px-sm-4">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-12 col-sm-11 col-md-8 col-lg-6">
					<div class="card shadow-lg border-0 rounded-lg overflow-hidden">
						<div class="card-header bg-dark-subtle text-white py-4">
							<h1 class="text-center mb-0 fs-4 fw-bold">Créer un compte</h1>
						</div>
						<div class="card-body p-4 p-md-5">
							{{ form_errors(registrationForm, { 'attr': { 'class': 'alert alert-danger alert-dismissible fade show' } }) }}

							{{ form_start(registrationForm, { 'attr': { 'class': 'needs-validation', 'novalidate': 'novalidate' } }) }}

							<div class="row g-3 mb-3">
								<div class="col-12 col-md-6">
									{{ form_row(registrationForm.firstname, { 'attr': { 'class': 'form-control form-control-lg' } }) }}
								</div>
								<div class="col-12 col-md-6">
									{{ form_row(registrationForm.lastname, { 'attr': { 'class': 'form-control form-control-lg' } }) }}
								</div>
							</div>

							<div class="mb-3">
								{{ form_row(registrationForm.email, { 'attr': { 'class': 'form-control form-control-lg' } }) }}
							</div>

							<div class="row g-3 mb-3">
								<div class="col-12 col-md-6">
									{{ form_row(registrationForm.phone, { 'attr': { 'class': 'form-control form-control-lg' } }) }}
								</div>
								<div class="col-12 col-md-6">
									{{ form_row(registrationForm.postalCode, { 'attr': { 'class': 'form-control form-control-lg' } }) }}
								</div>
							</div>

							<div class="mb-3">
								{{ form_row(registrationForm.adress, { 'attr': { 'class': 'form-control form-control-lg' } }) }}
							</div>

							<div class="row g-3 mb-3">
								<div class="col-12 col-md-6">
									{{ form_row(registrationForm.city, { 'attr': { 'class': 'form-control form-control-lg' } }) }}
								</div>
								<div class="col-12 col-md-6">
									{{ form_row(registrationForm.country, { 'attr': { 'class': 'form-control form-control-lg' } }) }}
								</div>
							</div>

							<div class="mb-3">
								{{ form_row(registrationForm.companyName, { 'attr': { 'class': 'form-control form-control-lg' } }) }}
							</div>

							<div class="row g-3 mb-4">
								<div class="col-12 col-md-6">
									{{ form_row(registrationForm.plainPassword.first, { 'attr': { 'class': 'form-control form-control-lg' } }) }}
								</div>
								<div class="col-12 col-md-6">
									{{ form_row(registrationForm.plainPassword.second, { 'attr': { 'class': 'form-control form-control-lg' } }) }}
								</div>
							</div>

							<div class="mb-4">
								{{ form_row(registrationForm.accountType, { 'attr': { 'class': 'form-select form-select-lg' } }) }}
							</div>

							<button type="submit" class="btn btn-primary btn-lg w-100 fw-semibold">S'inscrire</button>

							{{ form_end(registrationForm) }}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

{% endblock %}
