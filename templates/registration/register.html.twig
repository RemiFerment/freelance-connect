{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
    <h1>Créer un compte</h1>

    {{ form_errors(registrationForm) }}

    {{ form_start(registrationForm) }}

        {{ form_row(registrationForm.firstname) }}
        {{ form_row(registrationForm.lastname) }}

        {{ form_row(registrationForm.email) }}

        {{ form_row(registrationForm.phone) }}
        {{ form_row(registrationForm.adress) }}
        {{ form_row(registrationForm.postalCode) }}
        {{ form_row(registrationForm.city) }}
        {{ form_row(registrationForm.country) }}
        {{ form_row(registrationForm.companyName) }}

        {{ form_row(registrationForm.plainPassword, {
            label: 'Mot de passe'
        }) }}
        
        {{ form_row(registrationForm.accountType) }}

        <button type="submit" class="btn">S'inscrire</button>
        
    {{ form_end(registrationForm) }}
{% endblock %}
