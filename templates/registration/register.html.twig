{% extends 'base.html.twig' %}

{% block title %}Register
{% endblock %}

{% block body %}

	<div class="d-flex justify-content-center align-items-center min-vh-100 p-3">
		<div class="w-100" style="max-width: 500px;">
			<div class="card shadow-sm border-0">
				<div class="card-body p-4">
					<h1 class="text-center mb-4">Créer un compte</h1>

					{{ form_errors(registrationForm, { 'attr': { 'class': 'alert alert-danger' } }) }}

					{{ form_start(registrationForm, { 'attr': { 'class': 'needs-validation' } }) }}

					<div class="row g-3">
						<div class="col-md-6">
							{{ form_row(registrationForm.firstname, { 'attr': { 'class': 'form-control' } }) }}
						</div>
						<div class="col-md-6">
							{{ form_row(registrationForm.lastname, { 'attr': { 'class': 'form-control' } }) }}
						</div>
					</div>

					{{ form_row(registrationForm.email, { 'attr': { 'class': 'form-control' } }) }}

					<div class="row g-3">
						<div class="col-md-6">
							{{ form_row(registrationForm.phone, { 'attr': { 'class': 'form-control' } }) }}
						</div>
						<div class="col-md-6">
							{{ form_row(registrationForm.postalCode, { 'attr': { 'class': 'form-control' } }) }}
						</div>
					</div>

					{{ form_row(registrationForm.adress, { 'attr': { 'class': 'form-control' } }) }}

					<div class="row g-3">
						<div class="col-md-6">
							{{ form_row(registrationForm.city, { 'attr': { 'class': 'form-control' } }) }}
						</div>
						<div class="col-md-6">
							{{ form_row(registrationForm.country, { 'attr': { 'class': 'form-control' } }) }}
						</div>
					</div>

					{{ form_row(registrationForm.companyName, { 'attr': { 'class': 'form-control' } }) }}

					<div class="row g-3">
						<div class="col-md-6">
							{{ form_row(registrationForm.plainPassword.first, { 'attr': { 'class': 'form-control' } }) }}
						</div>
						<div class="col-md-6">
							{{ form_row(registrationForm.plainPassword.second, { 'attr': { 'class': 'form-control' } }) }}
						</div>
					</div>

					{{ form_row(registrationForm.accountType, { 'attr': { 'class': 'form-select' } }) }}

					<button type="submit" class="btn btn-primary w-100 mt-4">S'inscrire</button>

					{{ form_end(registrationForm) }}
				</div>
			{% endblock %}
