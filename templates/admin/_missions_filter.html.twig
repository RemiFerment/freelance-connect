{{ form_start(form, {method: 'GET'}) }}
<style>
    .categories-summary { list-style: none; }
    .categories-summary::-webkit-details-marker { display: none; }
    .categories-summary::marker { display: none; }
</style>
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-start">
            <div class="col-md-3">
                {{ form_row(form.client) }}
            </div>
            <div class="col-md-3">
                {{ form_row(form.freelance) }}
            </div>
            <div class="col-md-3">
                {{ form_row(form.minBudget) }}
            </div>
            <div class="col-md-3">
                {{ form_row(form.maxBudget) }}
            </div>
            <div class="col-md-3">
                {{ form_row(form.startDate) }}
            </div>
            <div class="col-md-3">
                {{ form_row(form.endDate) }}
            </div>
            <div class="col-12 col-lg-6">
                <label class="form-label">Catégories</label>
                <details>
                    <summary class="form-select categories-summary" style="cursor: pointer;">
                        Sélectionner des catégories
                    </summary>
                    <div class="p-3 border rounded mt-1" style="max-height: 250px; overflow-y: auto;">
                        {% for child in form.categories %}
                            <div class="form-check">
                                {{ form_widget(child, {attr: {class: 'form-check-input'}}) }}
                                {{ form_label(child, null, {label_attr: {class: 'form-check-label'}}) }}
                            </div>
                        {% endfor %}
                    </div>
                </details>
            </div>
        </div>
        <div class="row mt-4">
            <div class="col-12 d-flex justify-content-center">
                <button class="btn btn-primary px-5">
                    Filtrer
                </button>
            </div>
        </div>
    </div>
</div>
{{ form_end(form) }}