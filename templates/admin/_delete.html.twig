<button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal{{ mission.id }}">
    Supprimer la mission
</button>
<div class="modal fade" id="deleteModal{{ mission.id }}" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmer la suppression</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Êtes-vous sûr de vouloir supprimer la mission <strong>{{ mission.title }}</strong> ? Cette action est irréversible.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <form method="post" action="{{ path('app_admin_mission_delete', {'id': mission.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ mission.id) }}">
                    <button type="submit" class="btn btn-danger">
                        Confirmer la suppression
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>